# Escolha o provedor: fake, manual, browser, openai ou anthropic
JARVIS_PROVIDER=browser

# OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Modelo padrão para API
JARVIS_MODEL=gpt-4.1-mini

# Diretório raiz autorizado para automações
JARVIS_ALLOWED_ROOT=E:\projects

# Confirmação obrigatória para comandos shell
JARVIS_REQUIRE_CONFIRMATION=true

# Manual provider
JARVIS_MANUAL_OPEN_PROMPT=true
JARVIS_MANUAL_EDITOR=notepad

# Browser provider experimental para ChatGPT Web
JARVIS_BROWSER_URL=https://chatgpt.com/
JARVIS_BROWSER_PROFILE=.jarvis/browser-profile
JARVIS_BROWSER_HEADLESS=false
JARVIS_BROWSER_TIMEOUT_SECONDS=240
JARVIS_BROWSER_AUTO_OPEN=true
JARVIS_BROWSER_KEEP_OPEN=true

# Voz
JARVIS_VOICE_ENABLED=false
JARVIS_VOICE_LANGUAGE=pt-BR
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=185
JARVIS_TTS_VOLUME=1.0
JARVIS_WAKE_WORD=jarvis
JARVIS_LISTEN_TIMEOUT=5
JARVIS_PHRASE_TIME_LIMIT=12
