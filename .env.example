# Escolha o provedor: fake, openai ou anthropic
JARVIS_PROVIDER=fake

# OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Modelo padrão
JARVIS_MODEL=gpt-4.1-mini

# Diretório raiz autorizado para automações
JARVIS_ALLOWED_ROOT=E:\Repositories

# Confirmação obrigatória para comandos shell
JARVIS_REQUIRE_CONFIRMATION=true

# Voz
# Dica: deixe false por padrão e use "jarvis --voice" quando quiser voz.
JARVIS_VOICE_ENABLED=false
JARVIS_VOICE_LANGUAGE=pt-BR
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=185
JARVIS_TTS_VOLUME=1.0
JARVIS_WAKE_WORD=jarvis
JARVIS_LISTEN_TIMEOUT=5
JARVIS_PHRASE_TIME_LIMIT=12
